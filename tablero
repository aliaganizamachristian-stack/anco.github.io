 if(cL)for(let i=cL.start;i<sL.length;i++){const row=sL[i];if(!row)continue;const cod=toCod(g(row,cL,'codigo')),d=toISO(g(row,cL,'fecha de vencimiento')),q=toNum(g(row,cL,'cantidad'));
