   if(t==='s')v=ss[+v];else if(t==='str'||t==='e')v=unesc(v);else if(t==='b')v=v==='1';else v=parseFloat(v);}
  if(v===''||v==null||(typeof v==='number'&&isNaN(v)))continue;
  (rows[+r[2]-1]||(rows[+r[2]-1]=[]))[ci]=v;
