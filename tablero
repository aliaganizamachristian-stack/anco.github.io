 const rels=await get('xl/_rels/workbook.xml.rels')||'',relMap={};
 for(const m of rels.matchAll(/<Relationship\b[^>]*>/g)){const id=/\bId="([^"]+)"/.exec(m[0]),tg=/\bTarget="([^"]+)"/.exec(m[0]);if(id&&tg)relMap[id[1]]=tg[1];}
