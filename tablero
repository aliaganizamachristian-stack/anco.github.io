 if(miss.length)throw new Error('No encontré la hoja '+miss.join(', ')+'. Usa el archivo Inventario_Datos.xlsx sin cambiar los nombres de las hojas.');
 const cP=findCols(sP,['codigo','producto','costo unitario'],['categoria','unidad','stock inicial','stock minimo']);
