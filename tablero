 const bad=[];if(!cP)bad.push('Productos (Codigo, Producto, Costo unitario)');if(!cM)bad.push('Movimientos (Fecha, Codigo, Tipo, Cantidad)');if(!cE)bad.push('Mermas (Fecha, Codigo, Cantidad, Motivo)');
 if(bad.length)throw new Error('No encontré los encabezados esperados en: '+bad.join('; ')+'. No cambies los nombres de las columnas.');
 const R={prod:[],mov:[],mer:[],lotes:[],par:{moneda:'S/',meta:4,crit:3,bajo:4,exc:10,lote:7},issues:{movBad:0,merBad:0,dupCod:0}};
 const seen=new Set(),g=(row,c,k)=>c.idx[k]==null?undefined:row[c.idx[k]];
 for(let i=cP.start;i<sP.length;i++){const row=sP[i];if(!row)continue;const cod=toCod(g(row,cP,'codigo'));if(!cod)continue;
  if(seen.has(cod)){R.issues.dupCod++;continue;}seen.add(cod);
