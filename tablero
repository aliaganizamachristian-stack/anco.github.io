function applyPreset(){
 const [mn,mx]=bounds(RAW);
 if(st.preset==='all'){st.from=mn;st.to=mx;}
 else if(st.preset==='7'){st.to=mx;st.from=addDays(mx,-6);}
 else if(st.preset==='30'){st.to=mx;st.from=addDays(mx,-29);}
 else if(st.preset==='mes'){st.to=mx;st.from=mx.slice(0,8)+'01';}
 if(st.from<mn)st.from=mn;if(st.to>mx)st.to=mx;if(st.from>st.to)st.from=st.to;
}
