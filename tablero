 for(let i=cM.start;i<sM.length;i++){const row=sM[i];if(!row||row.every(v=>v==null))continue;
  const d=toISO(g(row,cM,'fecha')),cod=toCod(g(row,cM,'codigo')),q=toNum(g(row,cM,'cantidad')),t=g(row,cM,'tipo');
  if(!cod&&!t&&q==null)continue;
  if(!d||!cod||q==null||!t){R.issues.movBad++;continue;}R.mov.push([d,cod,String(t),q]);}
 for(let i=cE.start;i<sE.length;i++){const row=sE[i];if(!row||row.every(v=>v==null))continue;
  const d=toISO(g(row,cE,'fecha')),cod=toCod(g(row,cE,'codigo')),q=toNum(g(row,cE,'cantidad')),mo=g(row,cE,'motivo');
