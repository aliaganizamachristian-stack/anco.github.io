.two{display:grid;gap:12px;grid-template-columns:repeat(2,minmax(0,1fr));flex:1}
.two .card{display:flex;flex-direction:column}
@media (max-width:620px){.two{grid-template-columns:minmax(0,1fr)}}
.h2s{font:400 12px/1 var(--font-body);color:var(--muted);letter-spacing:0}
.salwrap{flex:1;position:relative;min-height:150px}.salwrap #a-sal{position:absolute;inset:0;overflow:hidden}
.filt{display:flex;gap:8px;flex-wrap:wrap;margin:-2px 0 12px}
.filt .est-sel{margin-left:0}
.fillcol{flex:1;display:flex;flex-direction:column;justify-content:space-between;gap:12px}
.fillcol .bars{flex:1;justify-content:space-around;gap:6px}
.bal-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px 14px;padding-top:12px;border-top:1px solid var(--line)}
.bal-grid span{display:block;font-size:12px;color:var(--ink2)}
.bal-grid b{font:600 16px/1.25 var(--font-display)}
.bal-n{font-family:var(--font-display);font-size:30px;font-weight:700;line-height:1.1}
.bal-s{color:var(--ink2);font-size:13px;margin:4px 0 14px}
.bal-bar{display:flex;height:14px;border-radius:7px;overflow:hidden;background:var(--wash)}
.bal-bar i{display:block;min-width:2px}
.bal-leg{display:flex;justify-content:space-between;gap:8px;font-size:12.5px;color:var(--ink2);margin-top:8px;flex-wrap:wrap}
.bal-leg b{color:var(--ink)}
.bal-f{padding-top:0;font-size:13px;color:var(--ink2)}
.bal-f b{color:var(--ink)}
.crit-f{margin-top:auto;padding-top:12px;font-size:13px;color:var(--ink2)}
.crit-f b{color:var(--ink)}
.est-sel{margin-left:8px;font:inherit;font-size:13px;padding:3px 8px;border:1px solid var(--line);border-radius:8px;background:var(--surface);color:var(--ink)}
[hidden]{display:none!important}
.nodata .tabs,.nodata #note,.nodata .model,.nodata #foot,.nodata .about,.nodata #pbar{display:none}

/* Layout: encabezado con pestañas A/B/C. Cada modelo es una cuadrícula de 12 columnas: resumen arriba, detalle abajo.
   Color: azul = ingresos, naranja = merma, aqua = salidas. Estados con icono y texto, nunca solo color. */
:root{
  --font-display:"Bricolage Grotesque","Hanken Grotesk",system-ui,sans-serif;
  --font-body:"Hanken Grotesk",system-ui,-apple-system,"Segoe UI",sans-serif;
  --page:#f4f4f1; --surface:#fcfcfb; --ink:#0b0b0b; --ink2:#52514e; --muted:#6f6d67;
  --grid:#e1e0d9; --axis:#c3c2b7; --line:rgba(11,11,11,.10); --wash:rgba(11,11,11,.045);
  --blue:#2a78d6; --orange:#eb6834; --aqua:#1baf7a;
  --blue-wash:rgba(42,120,214,.12); --orange-wash:rgba(235,104,52,.10);
  --good:#006300; --bad:#c23030; --crit:#d03b3b; --warn:#fab219; --ok:#0ca30c; --info:#2a78d6;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    color-scheme:dark;
    --page:#0d0d0d; --surface:#1a1a19; --ink:#ffffff; --ink2:#c3c2b7; --muted:#898781;
    --grid:#2c2c2a; --axis:#383835; --line:rgba(255,255,255,.10); --wash:rgba(255,255,255,.06);
    --blue:#3987e5; --orange:#d95926; --aqua:#199e70;
    --blue-wash:rgba(57,135,229,.16); --orange-wash:rgba(217,89,38,.14);
    --good:#0ca30c; --bad:#e66767;
  }
}
:root[data-theme="dark"]{
  color-scheme:dark;
  --page:#0d0d0d; --surface:#1a1a19; --ink:#ffffff; --ink2:#c3c2b7; --muted:#898781;
  --grid:#2c2c2a; --axis:#383835; --line:rgba(255,255,255,.10); --wash:rgba(255,255,255,.06);
  --blue:#3987e5; --orange:#d95926; --aqua:#199e70;
  --blue-wash:rgba(57,135,229,.16); --orange-wash:rgba(217,89,38,.14);
  --good:#0ca30c; --bad:#e66767;
}
/* Tema "suave": fondo azul grisáceo para que las tarjetas resalten; las líneas y barras conservan sus colores */
:root[data-skin="suave"]{
  --page:#e4eaf2; --surface:#fbfcfe; --ink:#0e1a2b; --ink2:#44526a; --muted:#566580;
  --grid:#dde4ee; --axis:#b4bfce; --line:rgba(20,40,70,.14); --wash:rgba(20,40,70,.06);
  --blue-wash:rgba(42,120,214,.13); --orange-wash:rgba(235,104,52,.11);
}
:root[data-skin="suave"] .card{box-shadow:0 1px 2px rgba(20,40,70,.07)}
*{box-sizing:border-box}
body{background:var(--page);color:var(--ink);font:14px/1.45 var(--font-body);-webkit-font-smoothing:antialiased}
.wrap{max-width:1240px;margin:0 auto;padding-inline:clamp(16px,3vw,32px);padding-block:22px 40px}
h1,h2,h3{margin:0;text-wrap:balance}
button,input,select{font:inherit;color:inherit}
:focus-visible{outline:2px solid var(--blue);outline-offset:2px}

/* Encabezado */
.head{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:14px 24px;margin-bottom:18px}
.eyebrow{font-size:12px;letter-spacing:.06em;text-transform:uppercase;color:var(--ink2);margin-bottom:4px}
h1{font:700 30px/1.1 var(--font-display);letter-spacing:-.01em}
.tabs{display:flex;gap:4px;padding:4px;background:var(--wash);border-radius:12px;flex-wrap:wrap}
.tab{border:1px solid transparent;background:none;padding:8px 14px;border-radius:9px;font-weight:600;font-size:13px;cursor:pointer;color:var(--ink2)}
.tab:hover{color:var(--ink)}
.tab[aria-selected="true"]{background:var(--surface);border-color:var(--line);color:var(--ink)}
.tab b{font-family:var(--font-display);margin-right:6px;color:var(--blue)}
.about{margin:0 0 16px;color:var(--ink2);max-width:70ch}

/* Cuadrícula y tarjetas */
.model[hidden]{display:none}
.grid{display:grid;gap:12px;grid-template-columns:repeat(12,minmax(0,1fr))}
.c12{grid-column:span 12}.c8{grid-column:span 8}.c7{grid-column:span 7}.c6{grid-column:span 6}.c5{grid-column:span 5}.c4{grid-column:span 4}
@media (max-width:980px){.c8,.c7,.c6,.c5,.c4{grid-column:span 12}}
.card{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:16px;min-width:0}
.card-h{display:flex;justify-content:space-between;align-items:baseline;gap:10px 16px;flex-wrap:wrap;margin-bottom:12px}
h2{font:600 15px/1.3 var(--font-display)}
.sub{color:var(--ink2);font-size:12.5px}
.legend{display:flex;gap:14px;flex-wrap:wrap;font-size:12.5px;color:var(--ink2)}
.legend i{display:inline-block;width:10px;height:10px;border-radius:3px;margin-right:6px;vertical-align:-1px}

/* KPI */
.kpis{display:grid;gap:12px;grid-template-columns:repeat(6,minmax(0,1fr))}
@media (max-width:1100px){.kpis{grid-template-columns:repeat(3,minmax(0,1fr))}}
.kpis.k4{grid-template-columns:repeat(4,minmax(0,1fr))}
@media (max-width:1100px){.kpis.k4{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media (max-width:620px){.kpis{grid-template-columns:repeat(2,minmax(0,1fr))}}
.kpi{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:14px 14px 12px;min-width:0;display:flex;flex-direction:column;gap:6px}
.kpi-l{font-size:12px;color:var(--ink2);letter-spacing:.02em}
.kpi-v{font:700 26px/1.1 var(--font-display);letter-spacing:-.01em;white-space:nowrap}
.kpi-f{display:flex;justify-content:space-between;align-items:flex-end;gap:6px;flex-wrap:wrap}
.delta{display:inline-flex;align-items:center;gap:4px;font-size:12px;font-weight:600;white-space:nowrap}
.delta.good{color:var(--good)}.delta.bad{color:var(--bad)}.delta.neutral{color:var(--ink2)}
.delta small{font-weight:400;color:var(--ink2)}
.spark{display:block;max-width:100%}
.ka{gap:4px}.ka .kpi-l{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ka-s{font-size:11px;color:var(--ink2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-height:15px}
.ka-c{margin-top:auto;padding-top:8px;min-height:44px;display:flex;align-items:flex-end;font-size:11px;color:var(--ink2)}
.ka-c .spark{width:100%;height:auto}

/* Barras horizontales */
.bars{display:flex;flex-direction:column;gap:7px}
.brow{display:grid;grid-template-columns:minmax(86px,.9fr) 2fr minmax(72px,auto);gap:10px;align-items:center;min-height:24px;border-radius:6px}
.brow:hover{background:var(--wash)}
.bl{font-size:13px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.bt{border-left:1px solid var(--axis);height:10px;display:flex;align-items:center}
.bt i{display:block;height:10px;background:var(--c);border-radius:0 4px 4px 0;min-width:2px}
.bv{text-align:right;font-weight:600;font-variant-numeric:tabular-nums;font-size:13px;white-space:nowrap}
.bx{font-weight:400;color:var(--ink2);margin-left:8px;font-size:12px}
@media (max-width:520px){.brow{grid-template-columns:minmax(70px,1fr) 1.4fr auto;gap:8px}.bx{display:none}}

/* Estados */
.chip{display:inline-flex;align-items:center;gap:5px;padding:2px 9px 2px 7px;border-radius:999px;background:var(--wash);font-size:12px;font-weight:600;white-space:nowrap}
.chip svg{flex:none}
.list{display:flex;flex-direction:column}
.card.c4:has(#a-alerts){display:flex;flex-direction:column}
#a-alerts{flex:1;justify-content:space-between}
.li{display:flex;justify-content:space-between;align-items:center;gap:10px 14px;flex-wrap:wrap;padding:10px 0;border-top:1px solid var(--grid)}
.li:first-child{border-top:0;padding-top:0}
.li b{font-weight:600}
.li .sub{display:block}

/* Meter y héroe */
.hero-n{font:700 clamp(44px,7vw,64px)/1 var(--font-display);letter-spacing:-.02em}
.hero-s{color:var(--ink2);margin-top:8px;max-width:44ch}

.meter-t{position:relative;height:12px;background:var(--wash);border-radius:6px}
.meter-f{position:absolute;inset:0 auto 0 0;background:var(--orange);border-radius:6px 4px 4px 6px}
.meter-m{position:absolute;top:-5px;bottom:-5px;width:2px;background:var(--ink)}
.meter-l{position:relative;height:18px;margin-top:8px;font-size:12px;color:var(--ink2)}
.meter-l span{position:absolute;white-space:nowrap}
.mini{display:grid;gap:12px;grid-template-columns:repeat(2,minmax(0,1fr))}
@media (max-width:520px){.mini{grid-template-columns:minmax(0,1fr)}}
.mini .kpi-v{font-size:22px;white-space:normal}

/* Gráficos SVG */
.chart{width:100%}
.chart svg{display:block;overflow:visible}
.gl{stroke:var(--grid);stroke-width:1}
.ax{stroke:var(--axis);stroke-width:1}
.tk{fill:var(--muted);font:11px var(--font-body)}
.tg{stroke:var(--ink2);stroke-width:1.5;stroke-dasharray:4 4;fill:none}
.tl{fill:var(--ink2);font:600 11px var(--font-body)}
.tl{margin-top:6px;padding-top:6px;border-top:1px solid rgba(255,255,255,.25);display:grid;gap:2px}
.pl{fill:var(--ink);font:500 12px var(--font-body)}
.cross{stroke:var(--ink2);stroke-width:1;stroke-dasharray:3 3}

/* Tooltip */
#tip{position:fixed;z-index:50;pointer-events:none;background:var(--ink);color:var(--surface);padding:8px 10px;border-radius:8px;font-size:12px;line-height:1.45;max-width:330px}
#tip b{font-weight:600}
#tip .r{display:flex;align-items:center;gap:6px;justify-content:space-between}
#tip .sw{display:inline-block;width:8px;height:8px;border-radius:2px;margin-right:6px}

/* Modelo C: tabla */
.tools{display:flex;gap:10px 14px;flex-wrap:wrap;align-items:center;margin-bottom:12px}
.search{flex:1 1 180px;min-width:0;max-width:280px;padding:8px 12px;border:1px solid var(--line);border-radius:9px;background:var(--surface)}
.chips{display:flex;gap:6px;flex-wrap:wrap}
.fc{border:1px solid var(--line);background:var(--surface);padding:6px 12px;border-radius:999px;cursor:pointer;font-size:12.5px;font-weight:500}
.fc:hover{background:var(--wash)}
.fc.sm{padding:3px 11px;font-size:11.5px}
.line-tools{display:flex;align-items:center;gap:8px 14px;flex-wrap:wrap}
.chip-btn{border:0;font:inherit;font-size:12px;font-weight:600;color:inherit;cursor:pointer;box-shadow:inset 0 0 0 1px var(--line)}
.chip-btn:hover{box-shadow:inset 0 0 0 1px var(--ink)}
.chip-btn:focus-visible{outline:2px solid var(--ink);outline-offset:2px}
.chip-btn .car{font-size:10px;margin-left:1px;transition:transform .12s}
.chip-btn[aria-expanded="true"] .car{transform:rotate(180deg)}
.xlist{flex-basis:100%;max-height:176px;overflow:auto;border-radius:8px;background:var(--wash);padding:3px 10px;font-size:12px}
.xlist[hidden]{display:none}
.xlist div{display:flex;justify-content:space-between;gap:12px;padding:5px 0;border-top:1px solid var(--grid)}
.xlist div:first-child{border-top:0}
.rvb{border:1px solid var(--line);background:var(--surface);border-radius:7px;font:600 11px var(--font-body);padding:2px 8px;cursor:pointer;color:var(--ink2);white-space:nowrap}.rvb:hover{color:var(--ink);background:var(--wash)}
.xlist b{font-weight:600;white-space:nowrap;font-variant-numeric:tabular-nums}
.fc[aria-pressed="true"]{background:var(--ink);color:var(--surface);border-color:var(--ink)}
.tscroll{overflow-x:auto;border:1px solid var(--line);border-radius:10px}
table{border-collapse:separate;border-spacing:0;width:100%;min-width:860px;font-size:13px}
th{position:sticky;top:0;background:var(--surface);text-align:left;font-weight:600;font-size:12px;color:var(--ink2);padding:0;border-bottom:1px solid var(--grid);white-space:nowrap}
th button{all:unset;cursor:pointer;display:block;padding:10px 12px;width:100%;box-sizing:border-box}
th button:hover{color:var(--ink)}
th button:focus-visible{outline:2px solid var(--blue);outline-offset:-2px}
th.r button{text-align:right}
td{padding:9px 12px;border-bottom:1px solid var(--grid);vertical-align:middle;white-space:nowrap}
tr:last-child td{border-bottom:0}
td.num{text-align:right;font-variant-numeric:tabular-nums}
.unit{color:var(--ink2);font-size:12px}
td .sub{display:block}
tbody tr{cursor:pointer}
tbody tr:hover td{background:var(--wash)}
tbody tr.sel td{background:var(--blue-wash)}
tbody tr:focus-visible{outline:2px solid var(--blue);outline-offset:-2px}
.stick{position:sticky;left:0;background:var(--surface);z-index:1}
tbody tr:hover .stick{background:var(--wash)}
tbody tr.sel .stick{background:var(--blue-wash)}
.cov{display:flex;align-items:center;gap:8px}
.cell-bar{display:flex;align-items:center;gap:8px;justify-content:flex-end}
.cell-bar i{display:block;height:8px;background:var(--orange);border-radius:0 4px 4px 0;min-width:2px}
.cell-bar b{font-weight:600;font-variant-numeric:tabular-nums;min-width:52px;text-align:right}
.facts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px 16px;margin:14px 0 16px}
.facts div span{display:block;font-size:12px;color:var(--ink2)}
.facts div b{font:600 18px/1.2 var(--font-display)}
.detail-wrap{position:sticky;top:12px}
.empty{padding:28px 12px;text-align:center;color:var(--ink2)}
.foot{margin-top:20px;color:var(--ink2);font-size:12.5px}
@media (prefers-reduced-motion:no-preference){.fc,.tab{transition:background .12s,color .12s}}

.note{margin:0 0 14px;padding:10px 14px;border:1px solid var(--line);border-radius:10px;background:var(--wash);color:var(--ink2);font-size:13px;max-width:100ch}
.note b{color:var(--ink)}
.bar{display:flex;flex-wrap:wrap;gap:10px 16px;align-items:center;margin:0 0 12px}
.btn{display:inline-flex;align-items:center;gap:8px;padding:8px 14px;border:1px solid var(--line);border-radius:9px;background:var(--surface);font-weight:600;font-size:13px;cursor:pointer}
.btn:hover{background:var(--wash)}
.btn.primary{background:var(--ink);color:var(--surface);border-color:var(--ink)}
.btn.primary:hover{opacity:.9;background:var(--ink)}
.src{color:var(--ink2);font-size:12.5px;min-width:0;overflow-wrap:anywhere}
.dates{display:flex;gap:8px;align-items:center;flex-wrap:wrap;font-size:12.5px;color:var(--ink2)}
.dates input{padding:6px 8px;border:1px solid var(--line);border-radius:8px;background:var(--surface);color:var(--ink)}
.msg{margin:0 0 12px;padding:10px 14px;border-radius:10px;border:1px solid var(--line);font-size:13px;max-width:100ch;overflow-wrap:anywhere}
.msg.err{background:var(--orange-wash);border-color:var(--orange)}
.msg.ok{background:var(--blue-wash);border-color:var(--blue)}
#app.drop{outline:2px dashed var(--blue);outline-offset:-6px}
.meter-top{display:flex;justify-content:space-between;gap:10px;font-size:12.5px;color:var(--ink2);margin-bottom:8px}
.meter-top b{color:var(--ink);font-variant-numeric:tabular-nums}
.meter{margin-top:20px}
</style>

