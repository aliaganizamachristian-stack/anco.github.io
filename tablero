 const sec=(t,rows)=>`<div class="li"><div><b>${t}</b></div></div>`+(rows.length?rows.join(''):'<div class="li"><span class="sub">Nada marcado.</span></div>');
 $('d-body').innerHTML=sec('Merma de producción sin Producción (-) · por producto',v.mp.map(c=>row(nm(c),'No se vuelve a avisar para este producto',{k:'mp',c})))
  +sec('Cuadre de producción · por día',v.cu.map(c=>row(lab(c.d),(c.x>0?`sale ${fmtN(c.x,1)} kg más de lo que entra`:`entra ${fmtN(-c.x,1)} kg más de lo que sale`),{k:'cu',d:c.d,x:c.x})))
  +sec('Tipo de cálculo de merma · por producto',Object.entries(v.modo||{}).map(([c,m])=>`<div class="li"><div><b>${esc(nm(c))}</b><span class="sub">${m==='p'?'Solo producción: promedio con días de Producción (-) y merma de producción':'Solo limpieza: promedio con días de compra'}</span></div><span><select class="est-sel" data-mc="${esc(c)}" aria-label="Tipo de cálculo"><option value="p"${m==='p'?' selected':''}>Solo producción</option><option value="l"${m==='l'?' selected':''}>Solo limpieza</option></select> <button type="button" class="rvb" data-mq="${esc(c)}">Quitar</button></span></div>`))
  +`<div class="li"><div><b>Agregar producto</b><span class="sub">Sin configurar = Automático (limpieza y producción mezcladas)</span></div><span><input id="d-prod" list="d-dl" class="est-sel" placeholder="Producto…" style="min-width:180px"><datalist id="d-dl">${RAW.prod.map(p=>`<option value="${esc(p.n)}">`).join('')}</datalist> <select class="est-sel" id="d-modo" aria-label="Tipo"><option value="p">Solo producción</option><option value="l">Solo limpieza</option></select> <button type="button" class="rvb" id="d-add">Agregar</button></span></div>`
  +`<div class="li"><span class="sub">Se guardan en este navegador y en datos.json. Si abres el tablero en otro navegador, carga primero tu datos.json con «Cargar Excel actualizado».</span></div>`;}
$('d-body').onclick=e=>{const b=e.target.closest('.rvb');if(!b)return;
