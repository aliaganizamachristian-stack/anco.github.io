/* ================= De hojas a datos ================= */
const norm=s=>String(s==null?'':s).toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g,'').replace(/\s+/g,' ').trim();
const MES=['ene','feb','mar','abr','may','jun','jul','ago','sep','oct','nov','dic'];
