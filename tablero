async function handleFile(f){
 if(!f||!IS_OWNER)return;
 if(/\.json$/i.test(f.name)){try{const r=JSON.parse(await f.text());if(!(r&&r.prod&&r.mov&&r.mer&&r.par))throw new Error('no es un datos.json del tablero');RAW=r;src=r.src||f.name;if(!(r.rev&&Array.isArray(r.rev.mp)&&Array.isArray(r.rev.cu)))RAW.rev={mp:[],cu:[],modo:{}};if(!RAW.rev.modo)RAW.rev.modo={};revPersist(false);st.preset='all';refresh();showMsg('ok','<b>Listo.</b> Cargué '+esc(f.name)+' con sus datos y revisados.');}catch(err){showMsg('err','<b>No pude leer ese datos.json.</b> '+esc(err.message||String(err)));}return;}
 if(!/\.xlsx$|\.xlsm$/i.test(f.name)){showMsg('err',`<b>No puedo leer ${esc(f.name)}.</b> Guarda el libro como .xlsx (Archivo > Guardar como > Libro de Excel) y vuelve a cargarlo. Los formatos .xlsb y .xls no se pueden leer aquí.`);return;}
 if(typeof DecompressionStream==='undefined'){showMsg('err','<b>Tu navegador es muy antiguo para leer Excel aquí.</b> Abre la página en una versión reciente de Chrome, Edge, Safari o Firefox.');return;}
 showMsg('ok','Leyendo '+esc(f.name)+'…');
 try{
  const R=extract(await readXlsx(await f.arrayBuffer()));
  revInit();R.rev=RAW&&RAW.rev?RAW.rev:{mp:[],cu:[]};
  RAW=R;const d=new Date();src=`${f.name} · cargado ${d.toLocaleDateString('es-PE')} ${d.toLocaleTimeString('es-PE',{hour:'2-digit',minute:'2-digit'})}`;
  RAW.src=src;st.preset='all';cst.sel=null;refresh();
  let saved=false;try{saveDb(RAW);saved=true;}catch(e){showMsg('err','<b>Se leyó el Excel pero no pude generar datos.json.</b> '+esc((e&&e.message)||String(e)));return;}
  const w=[];if(R.issues.movBad)w.push(`${R.issues.movBad} filas de Movimientos sin fecha, código, tipo o cantidad válidos`);if(R.issues.merBad)w.push(`${R.issues.merBad} filas de Mermas incompletas`);if(R.issues.dupCod)w.push(`${R.issues.dupCod} códigos repetidos en Productos`);
  if(M.Q.unkN)w.push(`${M.Q.unkN} filas con códigos que no están en Productos`);if(M.Q.badTipo.length)w.push('tipos desconocidos: '+esc(M.Q.badTipo.join(', ')));
  showMsg(w.length?'err':'ok',`<b>Listo.</b> Cargué ${R.prod.length} productos, ${R.mov.length} movimientos y ${R.mer.length} mermas.${w.length?' Ignoré o marqué: '+w.join('; ')+'.':''}${saved?' Se descargó <b>datos.json</b>. Súbelo al servicio donde publicaste el tablero (reemplazando el anterior) para que los demás vean estos datos.':''}`);
 }catch(err){showMsg('err','<b>No pude cargar el archivo.</b> '+esc(err.message||String(err)));}
}
/*revisados*/
const REV_KEY='inventario.revisados.v1';
function revInit(){if(!RAW)return;if(!(RAW.rev&&Array.isArray(RAW.rev.mp)&&Array.isArray(RAW.rev.cu)))RAW.rev={mp:[],cu:[],modo:{}};if(!RAW.rev.modo)RAW.rev.modo={};
 if(IS_OWNER){try{const t=localStorage.getItem(REV_KEY);if(t){const o=JSON.parse(t);if(o&&Array.isArray(o.mp)&&Array.isArray(o.cu)){if(!o.modo)o.modo={};RAW.rev=o;}}}catch(e){}}}
function revPersist(dirty=true){try{localStorage.setItem(REV_KEY,JSON.stringify(RAW.rev));}catch(e){}if(dirty)$('btn-dl').hidden=!IS_OWNER;}
function revMark(r){revInit();const v=RAW.rev;
 if(r.k==='mp'){if(!v.mp.includes(r.c))v.mp.push(r.c);}else if(r.k==='cu'){if(!v.cu.some(c=>c.d===r.d&&Math.abs(c.x-r.x)<0.05))v.cu.push({d:r.d,x:r.x});}
 revPersist();refresh();showMsg('ok','<b>Marcado como revisado.</b> Para que los demás lo vean, descarga datos.json y súbelo a Cloudflare. Puedes deshacerlo en la pestaña D.');}
function revModo(c,m){revInit();if(m==='a')delete RAW.rev.modo[c];else RAW.rev.modo[c]=m;revPersist();refresh();}
function revUndo(r){const v=RAW.rev;if(r.k==='mp')v.mp=v.mp.filter(c=>c!==r.c);else v.cu=v.cu.filter(c=>!(c.d===r.d&&Math.abs(c.x-r.x)<0.05));revPersist();refresh();}
function renderD(){const v=(RAW&&RAW.rev)||{mp:[],cu:[]};if(!IS_OWNER){$('d-body').innerHTML='';return;}
 const nm=c=>{const p=RAW.prod.find(x=>x.cod===c);return p?p.n:'Código '+c;};
