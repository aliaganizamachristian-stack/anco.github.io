<div class="wrap" id="app">
  <header class="head">
    <div>
      <div class="eyebrow" id="eyebrow">Inventario de carnes</div>
      <h1>Tablero de Inventario</h1>
    </div>
    <div class="tabs" role="tablist" aria-label="Modelos">
      <button class="tab" role="tab" id="tab-a" data-m="a" aria-selected="true"><b>A</b>Centro de control</button>
      <button class="tab" role="tab" id="tab-b" data-m="b" aria-selected="false"><b>B</b>Foco en merma</button>
      <button class="tab" role="tab" id="tab-c" data-m="c" aria-selected="false"><b>C</b>Por producto</button>
      <button class="tab" role="tab" id="tab-d" data-m="d" aria-selected="false" hidden><b>D</b>Revisados</button>
    </div>
  </header>

  <div class="bar">
    <button class="btn primary" id="btn-file" type="button" hidden>Cargar Excel actualizado</button>
    <button class="btn" id="btn-dl" type="button" hidden>Descargar datos.json con los cambios</button>
    <input id="file" type="file" accept=".xlsx,.xlsm,.json" hidden>
    <span class="src" id="src"></span>
    
  </div>
  <div class="msg" id="msg" role="status" hidden></div>
  <p class="note" id="empty" hidden></p>

  <div class="bar" id="pbar">
    <div class="chips" id="p-chips" aria-label="Periodo"></div>
    <div class="dates"><label for="d-from">Desde</label><input id="d-from" type="date"><label for="d-to">Hasta</label><input id="d-to" type="date"></div>
  </div>

  <p class="about" id="about"></p>
  <div class="note" id="note" role="note"></div>

  <section class="model" id="m-a" role="tabpanel" aria-labelledby="tab-a">
    <div class="kpis" id="a-kpis"></div>
    <div class="grid" style="margin-top:12px">
      <div class="c8 colstack">
      <div class="card">
        <div class="card-h"><div><h2>Compras y ventas</h2><div class="sub" id="a-line-sub">Valor a costo, solo días con movimientos</div></div>
          <div class="line-tools"><div class="chips" id="unit-chips" role="group" aria-label="Unidad"><button type="button" class="fc sm" data-u="s" aria-pressed="true">S/</button><button type="button" class="fc sm" data-u="k" aria-pressed="false">Kg</button></div><div class="chips" id="agg-chips" role="group" aria-label="Agrupar por"><button type="button" class="fc sm" data-a="w" aria-pressed="false">Semana</button><button type="button" class="fc sm" data-a="q" aria-pressed="false">Quincena</button><button type="button" class="fc sm" data-a="m" aria-pressed="false">Mes</button></div>
          <div class="legend"><span><i style="background:var(--blue)"></i>Compras</span><span><i style="background:var(--aqua)"></i>Ventas</span></div></div></div>
        <div class="chart" id="a-line"></div>
      </div>
      <div class="two">
        <div class="card">
          <div class="card-h"><div><h2>Salida semanal <small class="h2s">(promedio del periodo)</small></h2></div></div>
          <div class="filt"><select class="est-sel" id="sal-cat" aria-label="Categoría"></select><select class="est-sel" id="sal-est" aria-label="Estado de stock"></select></div>
          <div class="salwrap" id="a-salw"><div id="a-sal"></div></div>
        </div>
        <div class="card">
          <div class="card-h"><div><h2>Balance del periodo</h2><div class="sub">Ventas menos compras, ambas a costo</div></div></div>
          <div id="a-bal" class="fillcol"></div>
        </div>
      </div>
      </div>
      <div class="card c4">
        <div class="card-h"><div><h2>Datos por revisar</h2><div class="sub">Afectan el stock y los porcentajes</div></div></div>
        <div class="list" id="a-alerts"></div>
      </div>
      <div class="card c6">
        <div class="card-h"><div><h2>Productos que más ingresan</h2><div class="sub">Compras del periodo en kg y su valor</div></div></div>
        <div id="a-top-in"></div>
